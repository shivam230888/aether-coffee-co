{
  "version": 2,
  "installCommand": "npm install -g pnpm && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/aether-coffee run build:vercel",
  "outputDirectory": "artifacts/aether-coffee/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
